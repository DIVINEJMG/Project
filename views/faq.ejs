<body>
    <div class="header">Frequently Asked Questions</div>
    <div class="nav">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/services">Services</a>
        <a href="/about">About Us</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
