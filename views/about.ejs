<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - DSO Glorious Poultry Farm</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            text-align: center;
        }
        .header {
            background: #007bff;
            color: white;
            padding: 20px;
            font-size: 24px;
        }
        .nav {
            background: #0056b3;
            padding: 10px;
        }
        .nav a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
            margin: 5px;
            display: inline-block;
        }
        .nav a:hover {
            background: #003f7f;
        }
        .container {
            padding: 50px;
        }
        .btn {
            display: inline-block;
            padding: 10px 20px;
            margin: 10px;
            background: #28a745;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
        .btn:hover {
            background: #218838;
        }
        .product-section {
            margin-top: 30px;
        }
        .product-card {
            display: inline-block;
            background: white;
            padding: 20px;
            margin: 10px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="header">Welcome to DSO Glorious Poultry Farm</div>
    <div class="nav">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/services">Services</a>
        <a href="/about">About Us</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <% if (!user) { %>
            <a href="/auth/login" class="btn">Login</a>
            <a href="/auth/register" class="btn">Sign Up</a>
          <% } else { %>
            <a href="/auth/logout" class="btn">Logout</a>
          <% } %>
    </div>
    <div class="container">
        <h2>Fresh Poultry Products Delivered to You</h2>
        <p>Explore our range of high-quality poultry products.</p>
    </div>
    <div class="product-section">
        <h3>Our Products</h3>
        <div class="product-card">
            <h4>Fresh Chicken</h4>
            <p>High-quality free-range chicken.</p>
            <p><strong>Price: $20</strong></p>
        </div>
        <div class="product-card">
            <h4>Organic Eggs</h4>
            <p>Farm-fresh organic eggs.</p>
            <p><strong>Price: $5</strong></p>
        </div>
        <div class="product-card">
            <h4>Natural Manure</h4>
            <p>Organic manure for your crops.</p>
            <p><strong>Price: $15</strong></p>
        </div>
    </div>
</body>
</html>
