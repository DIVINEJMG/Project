<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Home - DSO Glorious Poultry Farm</title>
  <style>
    /* Full-page background slider */
    .background-slider {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      background-size: cover;
      background-position: center;
      transition: opacity 1s ease-in-out;
    }

    /* Page Styling */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f8f9fa;
      position: relative;
      z-index: 1;
    }

    .header {
      background: rgba(0, 123, 255, 0.8);
      color: white;
      padding: 20px;
      font-size: 24px;
      font-weight: bold;
      text-align: center;
    }

    .nav {
      background: rgba(0, 86, 179, 0.8);
      padding: 10px;
      text-align: center;
      white-space: nowrap;
      overflow-x: auto;
    }

    .nav a {
      color: white;
      text-decoration: none;
      padding: 10px 15px;
      margin: 0 5px;
      display: inline-block;
      transition: background 0.3s ease;
    }

    .nav a:hover {
      background: rgba(0, 63, 127, 0.8);
      border-radius: 5px;
    }

    .container {
      padding: 50px;
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
    }

    .product-section {
      margin-top: 30px;
      position: relative;
      z-index: 1;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      padding: 20px;
    }

    .product-card {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
    }

    .product-card:hover {
      transform: translateY(-5px);
    }

    .price {
      color: #333;
      font-size: 1.2rem;
      margin: 10px 0;
    }

    .btn {
      display: inline-block;
      padding: 10px 20px;
      margin: 10px;
      background: #28a745;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      transition: background 0.3s ease;
    }

    .btn:hover {
      background: #218838;
    }

    footer {
      background: rgba(0, 86, 179, 0.8);
      color: white;
      padding: 30px;
      margin-top: 50px;
      text-align: center;
    }

    .subscription-cta {
      background: rgba(255, 255, 255, 0.9);
      padding: 40px 20px;
      margin: 30px 0;
      text-align: center;
    }

    @media (max-width: 768px) {
      .nav {
        white-space: normal;
        text-align: center;
      }
      
      .nav a {
        display: inline-block;
        margin: 5px;
      }

      .container {
        padding: 20px;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Background Slider -->
  <div class="background-slider" id="backgroundSlider"></div>

  <div class="header">Welcome to DSO Glorious Poultry Farm</div>

  <nav class="nav">
    <a href="/">Home</a>
    <a href="/products">Products</a>
    <a href="/services">Services</a>
    <a href="/about">About Us</a>
    <a href="/faq">FAQ</a>
    <a href="/contact">Contact</a>
    <% if (!user) { %>
      <a href="/auth/login" class="btn">Login</a>
      <a href="/auth/register" class="btn">Sign Up</a>
    <% } else { %>
      <a href="/auth/logout" class="btn">Logout</a>
    <% } %>
  </nav>

  <div class="container">
    <h2>Fresh Poultry Products Delivered to You</h2>
    <p>Explore our range of high-quality poultry products.</p>

    <div class="subscription-cta">
      <h3>Subscribe & Save 10%</h3>
      <p>Get regular deliveries of fresh poultry products</p>
      <a href="/subscriptions" class="btn">View Plans</a>
    </div>

    <div class="product-section">
      <h3>Our Products</h3>
      <div class="product-grid">
        <div class="product-card">
          <h4>Fresh Chicken</h4>
          <p>High-quality free-range chicken.</p>
          <p class="price">Price: $20</p>
          <button class="btn">Add to Cart</button>
        </div>
        <div class="product-card">
          <h4>Organic Eggs</h4>
          <p>Farm-fresh organic eggs.</p>
          <p class="price">Price: $5</p>
          <button class="btn">Add to Cart</button>
        </div>
        <div class="product-card">
          <h4>Natural Manure</h4>
          <p>Organic manure for your crops.</p>
          <p class="price">Price: $15</p>
          <button class="btn">Add to Cart</button>
        </div>
      </div>
    </div>
  </div>

  <footer>
    <div class="footer-content">
      <p>📞 Contact: 123-456-7890</p>
      <p>📍 Farm Address: 123 Poultry Lane, Farm City</p>
      <div class="social-links">
        <a href="#">Facebook</a> | 
        <a href="#">Instagram</a> | 
        <a href="#">Twitter</a>
      </div>
      <p>© 2023 DSO Glorious Poultry Farm</p>
    </div>
  </footer>

  <!-- Preserved Original Scripts -->
  <script>
    var currentUser = <%= JSON.stringify(user || null) %>;
    console.log("Current user:", currentUser);
  </script>
  
  <script>
    const backgrounds = [
      '/images/download%20(1).jfif',
      '/images/download.jfif',
      '/images/images%20(1).jfif'
    ];

    let bgIndex = 0;
    const bgSlider = document.getElementById('backgroundSlider');

    function changeBackground() {
      bgSlider.style.opacity = 0;

      setTimeout(() => {
        bgSlider.style.backgroundImage = `url(${backgrounds[bgIndex]})`;
        bgSlider.style.opacity = 1;
        bgIndex = (bgIndex + 1) % backgrounds.length;
      }, 1000);

      setTimeout(changeBackground, 5000);
    }

    changeBackground();
  </script>

</body>
</html>