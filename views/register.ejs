<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - DSO Glorious Farm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2E7D32;
            --secondary-color: #FFD700;
            --hover-color: #1B5E20;
        }

        body {
            background: linear-gradient(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.9)), url('/images/farm-register-bg.jpg') center/cover fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .register-container {
            max-width: 400px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            margin: 20px;
            transition: all 0.3s ease;
        }

        .register-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        .register-header {
            background: var(--primary-color);
            padding: 2rem;
            text-align: center;
        }

        .brand-logo {
            width: 80px;
            margin-bottom: 1rem;
        }

        .register-form {
            padding: 2rem;
        }

        .form-control {
            border-radius: 8px;
            padding: 12px 20px;
            border: 2px solid #e0e0e0;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 8px rgba(46, 125, 50, 0.2);
        }

        .btn-success {
            background: var(--primary-color);
            border: none;
            padding: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            width: 100%;
        }

        .btn-success:hover {
            background: var(--hover-color);
            transform: translateY(-2px);
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-color);
        }

        .input-group {
            position: relative;
        }

        .form-control {
            padding-left: 40px;
        }

        @media (max-width: 576px) {
            .register-container {
                margin: 15px;
            }
            
            .register-header h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <img src="/images/logo.png" alt="DSO Glorious Farm" class="brand-logo">
            <h2 class="text-white mb-0">Join Our Farm Family</h2>
            <p class="text-white-50 mb-0">Start your agricultural journey</p>
        </div>

        <div class="register-form">
            <% if (error_msg) { %>
                <div class="alert alert-danger d-flex align-items-center mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= error_msg %>
                </div>
            <% } %>

            <form action="/auth/register" method="POST">
                <div class="mb-4">
                    <label class="form-label">Username</label>
                    <div class="input-group">
                        <i class="fas fa-user input-icon"></i>
                        <input type="text" 
                               class="form-control" 
                               name="username" 
                               placeholder="Enter unique username"
                               required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" 
                               class="form-control" 
                               name="password" 
                               placeholder="Create strong password"
                               required>
                    </div>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-seedling me-2"></i>Grow With Us
                    </button>
                </div>

                <div class="text-center">
                    <p class="mb-0">
                        Already a member? 
                        <a href="/auth/login" class="text-decoration-none fw-bold" style="color: var(--primary-color);">
                            Sign In
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</body>
</html>